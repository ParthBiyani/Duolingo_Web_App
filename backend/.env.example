# SQLite database URL. Defaults to backend/data/app.db, whatever the working directory.
# On a host with a persistent disk, use an absolute path on that disk:
# DATABASE_URL=sqlite:////var/data/app.db
# development | test | production (production marks the session cookie Secure)
APP_ENV=development
# Enables /api/v1/demo/* (simulated clock and data reset); off unless set
DEMO_TOOLS=true
# Signs the session cookie (HMAC-SHA256). Optional locally; required in production, where the
# API logs a warning if it is missing. Any long random string, e.g. from
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# debug | info | warning | error | critical
LOG_LEVEL=info
