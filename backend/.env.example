# SQLite database URL. Defaults to backend/data/app.db, whatever the working directory.
# In production use an absolute path on the persistent disk:
# DATABASE_URL=sqlite:////var/data/app.db
# development | test | production
APP_ENV=development
# Enables /api/v1/demo/* (simulated clock and data reset); off unless set
DEMO_TOOLS=true
# Signs the session cookie. Any long random string; set one in production, e.g. from
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# debug | info | warning | error | critical
LOG_LEVEL=info
