    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
